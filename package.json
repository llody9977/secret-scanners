{
  "name": "secret-scanners",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node scripts/serve-static.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
